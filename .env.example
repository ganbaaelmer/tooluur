# .env.example — placeholder утгууд. Бодит `.env` нь git-д ХЭЗЭЭ Ч орохгүй (.gitignore).
# Энэ файлыг л commit хийнэ.

# ── GitHub deploy ──
# Repo: Settings → Developer settings → Personal access tokens (fine-grained).
# Зөвхөн шаардлагатай scope: Contents: read/write, Pages: read/write. Хугацаа тавь (90 хоног).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USER=your-github-username
GITHUB_REPO=tooluur

# ── Домэйн ──
SITE_DOMAIN=tooluur.website

# ⚠️ sudo пароль зэрэг системийн credential-ыг .env-д хадгалахгүй.
#    Хэрэгтэй бол `sudo -v` гэж интерактиваар оруул, эсвэл `pass`/`secret-tool` ашигла.
